# FORMAT :
#   KEY=VALUE1 # COMMENT HERE

# --- GENERAL ---
DOMAIN_NAME={DOMAIN_NAME.[EXT]}

# --- FTP VARIABLE ---
FTP_PASSWORD={PASSWORD_HERE} # Is the password of the ftp user

# --- MARIADB VARIABLE ---
MARIADB_USERNAME={USERNAME_HERE} # Is the name of the default user
MARIADB_PASSWORD={PASSWORD_HERE} # Is the password of the default user
MARIADB_DOMAIN={DOMAINE_HERE.[EXT]} # Is the hostname to connect to the database
MARIADB_ROOT_PASSWORD={PASSWORD_HERE} # Is the password of the root user

# --- WORDPRESS VARIABLE ---
WORDPRESS_AUTH_PASSWORD={PASSWORD_HERE} # The password
WORDPRESS_SALT_PASSWORD={PASSWORD_HERE} # The password
