server {
        listen 443 ssl;

        server_name adminer.nclavel.42.fr ;

        root /var/www/adminer;
        index index.php index.html;

        location = /adminer {
            include fastcgi_params;
            fastcgi_param SCRIPT_FILENAME /var/www/adminer/index.php;
            fastcgi_param SCRIPT_NAME /adminer;
            fastcgi_pass adminer:4444;
        }

        location = /adminer/ {
            include fastcgi_params;
            fastcgi_param SCRIPT_FILENAME /var/www/adminer/index.php;
            fastcgi_param SCRIPT_NAME /adminer/;
            fastcgi_pass adminer:4444;
        }

        location / {
            include fastcgi_params;
            fastcgi_param SCRIPT_FILENAME /var/www/adminer/index.php;
            fastcgi_param SCRIPT_NAME /adminer;
            fastcgi_pass adminer:4444;
        }
    }
